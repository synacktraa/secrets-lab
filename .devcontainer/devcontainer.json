{
  "name": "secrets-lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    // python:3.12 is Debian trixie, which has no Microsoft "moby" packages,
    // so install Docker CE instead. With moby on, the build fails.
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "helm": "none", "minikube": "none" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
